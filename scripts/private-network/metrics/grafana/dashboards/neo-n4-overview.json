      "id": 6,
      "type": "stat",
      "title": "Settlement backlog",
      "gridPos": { "h": 8, "w": 4, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "neo-n4-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 20 },
              { "color": "red", "value": 50 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "neo-n4-prometheus" },
          "expr": "max(l2_settlement_pending)",
          "legendFormat": "pending",
          "refId": "A"
        }
      ]
    },
