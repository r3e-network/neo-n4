<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

  <PropertyGroup Condition="'$(OS)' == 'Windows_NT' and '$(RuntimeIdentifier)' == ''">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compiled in rather than referenced: a project reference would drag this file's consumers'
         plugin dependencies along, and every test assembly needs the probe anyway.
         ProofRoutingExpectations is the third reference behind the SecurityLevel => ProofType rule
         (audit finding H18). It has to be visible to NeoHub.Contracts.VmTests, which executes the
         compiled contract, and to Neo.L2.Abstractions.UnitTests, which executes the off-chain mirror,
         without either project referencing the other. -->
    <Compile Include="$(MSBuildThisFileDirectory)Shared/RepoRoot.cs" Link="Shared\RepoRoot.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/ProofRoutingExpectations.cs"
             Link="Shared\ProofRoutingExpectations.cs" />
    <!-- CanonicalEncodingVectors is the third reference behind the cross-boundary encodings
         (audit finding V2). It has to be visible both to the projects that call the canonical
         encoders and to NeoHub.Contracts.VmTests, which deploys the compiled contracts and
         hand-rolls the same buffers because it can carry no project reference. -->
    <Compile Include="$(MSBuildThisFileDirectory)Shared/CanonicalEncodingVectors.cs"
             Link="Shared\CanonicalEncodingVectors.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
