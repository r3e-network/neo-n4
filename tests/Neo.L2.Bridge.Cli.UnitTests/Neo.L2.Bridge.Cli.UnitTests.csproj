<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Neo.L2.Bridge.Cli.UnitTests</RootNamespace>
    <AssemblyName>Neo.L2.Bridge.Cli.UnitTests</AssemblyName>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="$(MSTestVersion)" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.3.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tools\Neo.L2.Bridge.Cli\Neo.L2.Bridge.Cli.csproj" />
    <ProjectReference Include="..\..\src\Neo.L2.State\Neo.L2.State.csproj" />
    <ProjectReference Include="..\..\src\Neo.Plugins.L2Rpc\Neo.Plugins.L2Rpc.csproj" />
    <!-- DepositPayload canonical encoding tests require access to Neo.L2.Bridge -->
    <ProjectReference Include="..\..\src\Neo.L2.Bridge\Neo.L2.Bridge.csproj" />
  </ItemGroup>

</Project>
