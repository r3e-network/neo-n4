<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Neo.L2.Executor.UnitTests</RootNamespace>
    <AssemblyName>Neo.L2.Executor.UnitTests</AssemblyName>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="$(MSTestVersion)" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.3.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Neo.L2.Executor\Neo.L2.Executor.csproj" />
    <ProjectReference Include="..\..\src\Neo.L2.Persistence\Neo.L2.Persistence.csproj" />
    <ProjectReference Include="$(NeoCorePath)\Neo\Neo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\bridge\neo-zkvm-guest\tests\fixtures\native_execution_output_v1.hex"
          Link="Fixtures\native_execution_output_v1.hex"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
