<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Neo.L2.Settlement.Rpc.UnitTests</RootNamespace>
    <AssemblyName>Neo.L2.Settlement.Rpc.UnitTests</AssemblyName>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Note: Excluding AWS KMS and HSM CLI signer tests until operator SDK provisions
       AWSSDK.KeyManagementService and Azure SDK packages. These test files remain
       in place but are excluded from compilation. See doc.md §14.2 and src/...
       csproj for context. Excluded: 2026-09-06 per build fix task. -->

  <ItemGroup>
    <PackageReference Include="MSTest" Version="$(MSTestVersion)" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.3.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Neo.L2.Settlement.Rpc\Neo.L2.Settlement.Rpc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="UT_AwsKmsTransactionSigner.cs;UT_AzureKeyVaultTransactionSigner.cs;
        UT_HsmCliTransactionSigner.cs;UT_KmsHsmSignerIntegration.cs" />
  </ItemGroup>

</Project>
