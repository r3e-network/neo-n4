# Golden canonical-encoding vectors, exported for the Rust test lane.
#
# The .NET lane reads these bytes from tests/Shared/CanonicalEncodingVectors.cs; the Rust lane reads
# THIS file (bridge/neo-execution-core/tests/canonical_encoding_parity.rs). A test in
# tests/Neo.L2.IntegrationTests/UT_CanonicalEncodingParity.cs asserts this export equals those
# vectors byte for byte, so the two lanes cannot drift apart silently.
#
# What the Rust side checks against them: that hash_public_inputs assembles the ten fields below into
# a buffer whose Hash256 equals public_input_hash (i.e. its parameter order is the order
# EncodePublicInputs writes), and that merkle_root over withdrawal_leaf_* reproduces
# withdrawal_root. Both claims are about Rust's own hidden tables, which no earlier test compared to
# anything outside Rust: the repo's existing cross-language vectors
# (native.rs::outbound_v1_roots_bind_native_abi_order_and_parameters and
# UT_CanonicalNativeExecutionAdapter.cs::OutboundV1_MatchesRustRootsAndBindsOrderAndParameters)
# paste the same expected digest into both languages, which works only while nobody edits one copy.
#
# Provenance: the vectors were produced by a throwaway third implementation in a language neither
# side uses, not by running either encoder. Integers are decimal; byte strings are lowercase hex.
#
# See docs/audit/subsystem-verification-audit-2026-08-30.md V2.

chain_id=1001
batch_number=1
first_block=2
last_block=3
proof_type=1

# the ten 32-byte fields of the public-inputs preimage, in preimage order
pre_state_root=1010101010101010101010101010101010101010101010101010101010101010
post_state_root=a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1
